{
  "id": "selector-match-basics",
  "harness_type": "selector-match",
  "title": "Which Rules Match?",
  "scenario": "Below is part of a page's HTML, and below that a small stylesheet. A selector like .sidebar p matches a <p> with any ancestor — not just its immediate parent — that has class \"sidebar\". A selector like main > p matches a <p> only if main is its immediate parent. Judge each rule on its own, ignoring the others: does its selector match the highlighted element? If so, type the color it declares. If not, type \"none\". Rules aren't competing here — more than one is allowed to match the same element.",
  "related_units": [],
  "payload": {
    "instances": [
      {
        "tree": {
          "tag": "body",
          "children": [
            {
              "tag": "main",
              "children": [
                {
                  "tag": "section",
                  "class": "sidebar",
                  "children": [
                    { "tag": "ul", "children": [] }
                  ]
                },
                {
                  "tag": "section",
                  "class": "content",
                  "children": [
                    {
                      "tag": "article",
                      "children": [
                        { "tag": "p", "children": [], "target": true }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "rules": [
          { "display": ".sidebar p", "match": { "tag": "p" }, "ancestor": { "class": "sidebar", "combinator": "descendant" }, "color": "gold" },
          { "display": ".content p", "match": { "tag": "p" }, "ancestor": { "class": "content", "combinator": "descendant" }, "color": "coral" },
          { "display": "main > p", "match": { "tag": "p" }, "ancestor": { "tag": "main", "combinator": "child" }, "color": "navy" },
          { "display": "p", "match": { "tag": "p" }, "color": "slate" }
        ]
      },
      {
        "tree": {
          "tag": "body",
          "children": [
            {
              "tag": "main",
              "children": [
                {
                  "tag": "section",
                  "class": "sidebar",
                  "children": [
                    { "tag": "ul", "children": [] }
                  ]
                },
                {
                  "tag": "section",
                  "class": "content",
                  "children": [
                    { "tag": "article", "children": [] }
                  ],
                  "target": true
                }
              ]
            }
          ]
        },
        "rules": [
          { "display": "main > section", "match": { "tag": "section" }, "ancestor": { "tag": "main", "combinator": "child" }, "color": "navy" },
          { "display": ".sidebar section", "match": { "tag": "section" }, "ancestor": { "class": "sidebar", "combinator": "descendant" }, "color": "gold" },
          { "display": "body section", "match": { "tag": "section" }, "ancestor": { "tag": "body", "combinator": "descendant" }, "color": "teal" },
          { "display": ".content", "match": { "class": "content" }, "color": "coral" }
        ]
      },
      {
        "tree": {
          "tag": "body",
          "children": [
            {
              "tag": "main",
              "children": [
                {
                  "tag": "article",
                  "class": "product",
                  "children": [
                    {
                      "tag": "div",
                      "class": "details",
                      "children": [
                        { "tag": "h2", "class": "title", "children": [] },
                        {
                          "tag": "span",
                          "class": "price",
                          "children": [],
                          "target": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "rules": [
          { "display": ".title span", "match": { "tag": "span" }, "ancestor": { "class": "title", "combinator": "descendant" }, "color": "gold" },
          { "display": ".details span", "match": { "tag": "span" }, "ancestor": { "class": "details", "combinator": "descendant" }, "color": "purple" },
          { "display": "article > span", "match": { "tag": "span" }, "ancestor": { "tag": "article", "combinator": "child" }, "color": "navy" },
          { "display": "div > span", "match": { "tag": "span" }, "ancestor": { "tag": "div", "combinator": "child" }, "color": "coral" }
        ]
      }
    ]
  }
}
