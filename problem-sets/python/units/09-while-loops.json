    {
      "id": "09",
      "source_unit": "while-loops",
      "title": "Keep Asking Until Valid",
      "difficulty": 2,
      "sidebar_tag": "while",
      "description": [
        "<p>Read integers, one at a time, until a <strong>positive</strong>",
        "number is entered &mdash; discarding zero and negative numbers along",
        "the way. Once a positive number arrives, print",
        "<code>Got it: &lt;value&gt;</code>.</p>",
        "<pre>&gt; python program.py",
        "-5",
        "-3",
        "7",
        "Got it: 7</pre>",
        "<p>This pattern &mdash; read a value, and if it isn't good enough, read",
        "another one &mdash; comes up constantly whenever a program needs to",
        "insist on valid input before moving on.</p>"
      ],
      "starter": [
        "n = int(input())",
        "",
        "# TODO: while n <= 0, read another n.",
        "# Then print an f-string: Got it: <n>"
      ],
      "tests": [
        {
          "stdin": [
            "-5",
            "-3",
            "7"
          ],
          "expected": "Got it: 7"
        },
        {
          "stdin": [
            "4"
          ],
          "expected": "Got it: 4"
        },
        {
          "stdin": [
            "0",
            "0",
            "1"
          ],
          "expected": "Got it: 1"
        }
      ]
    },
