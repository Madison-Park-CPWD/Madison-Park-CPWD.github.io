        "<pre>&gt; python program.py",
        "Ava",
        "Hello, Ava!</pre>",
        "<p>A parameter is a variable that only exists inside the function,",
        "filled in with whatever value you pass when you call it.</p>"
      ],
      "starter": [
        "def greet(name):",
        "    # TODO: print an f-string greeting using name",
        "",
