{
  "id": "float-math",
  "title": "Float Math",
  "reflection_prompt": "In your own words, why doesn't 0.1 + 0.2 print exactly 0.3? Why does that matter when comparing float values in real programs?",
  "exercises": [
    {
      "id": "01",
      "source_unit": "float-math",
      "title": "Sum of Two Floats",
      "sidebar_tag": "+",
      "description": [
        "<p>Read two floating-point numbers from input, one per line, and print",
        "their <strong>sum</strong> using the <code>+</code> operator.</p>",
        "<p>Use <code>float(input())</code> instead of <code>int(input())</code> to",
        "read a number that can have a decimal point.</p>",
        "<pre>&gt; python program.py",
        "2.5",
        "1.5",
        "4.0</pre>"
      ],
      "starter": [
        "# TODO: read two floats, then print their sum"
      ],
      "tests": [
        {
          "stdin": [
            "2.5",
            "1.5"
          ],
          "expected": "4.0"
        },
        {
          "stdin": [
            "10.5",
            "4.25"
          ],
          "expected": "14.75"
        },
        {
          "stdin": [
            "0.5",
            "0.5"
          ],
          "expected": "1.0"
        },
        {
          "stdin": [
            "100.25",
            "50.75"
          ],
          "expected": "151.0"
        },
        {
          "stdin": [
            "3.75",
            "1.25"
          ],
          "expected": "5.0"
        }
      ]
    },
    {
      "id": "02",
      "source_unit": "float-math",
