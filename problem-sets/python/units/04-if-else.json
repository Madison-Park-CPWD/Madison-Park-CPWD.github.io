{
  "id": "if-else",
  "title": "If / Else",
  "reflection_prompt": "Think of a real decision you make in daily life. How would you write it as an if/elif/else chain?",
  "exercises": [
    {
      "id": "01",
      "source_unit": "if-else",
      "title": "Positive or Not",
      "difficulty": 2,
      "sidebar_tag": "if/else",
      "description": [
        "<p>Read an integer <code>n</code> and print <code>Positive</code> if it is",
        "greater than 0, or <code>Not Positive</code> otherwise.</p>",
        "<pre>&gt; python program.py",
        "5",
        "Positive</pre>",
        "<p>An <code>if</code>/<code>else</code> statement runs one block of code or",
        "the other, depending on whether the condition is true.</p>"
      ],
      "starter": [
        "# TODO: read an integer, then print \"Positive\" if it's greater than 0,",
        "# otherwise print \"Not Positive\""
      ],
      "tests": [
        {
          "stdin": [
            "5"
          ],
          "expected": "Positive"
        },
        {
          "stdin": [
            "-3"
          ],
          "expected": "Not Positive"
        },
        {
          "stdin": [
            "0"
          ],
          "expected": "Not Positive"
        },
        {
          "stdin": [
            "100"
          ],
          "expected": "Positive"
        },
        {
          "stdin": [
            "-1"
          ],
          "expected": "Not Positive"
        }
      ]
    },
    {
