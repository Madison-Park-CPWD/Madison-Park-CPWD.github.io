    {
      "id": "10",
      "source_unit": "if-else",
      "title": "Fix the Bug",
      "difficulty": 1,
      "sidebar_tag": "debug",
      "description": [
        "<p>This code is supposed to sort a temperature into <code>Freezing</code>,",
        "<code>Cold</code>, <code>Warm</code>, or <code>Hot</code> &mdash; the same",
        "categories as an earlier exercise. Run it with a cold temperature like",
        "<code>20</code> and see what it actually prints.</p>"
      ],
      "starter": [
        "temp = int(input())",
        "if temp <= 100:",
        "    print(\"Warm\")",
        "elif temp < 32:",
        "    print(\"Freezing\")",
        "else:",
        "    print(\"Hot\")"
      ],
      "tests": [
        {
          "stdin": [
            "20"
          ],
          "expected": "Freezing"
        },
        {
          "stdin": [
            "150"
          ],
          "expected": "Hot"
        },
        {
          "stdin": [
            "50"
          ],
          "expected": "Warm"
        },
        {
          "stdin": [
            "31"
          ],
          "expected": "Freezing"
        },
        {
          "stdin": [
            "101"
          ],
          "expected": "Hot"
        }
      ]
    }
  ]
