      ],
      "starter": [
        "age = int(input())",
        "if age >= 18:",
        "    registered = input()",
        "print(\"checking registration\")",
        "if registered == \"yes\":",
        "    print(\"Can vote\")",
        "else:",
        "    print(\"Must register first\")"
      ],
      "tests": [
        {
          "stdin": [
            "20",
            "yes"
          ],
          "expected": "Can vote"
        },
        {
          "stdin": [
            "20",
            "no"
          ],
          "expected": "Must register first"
        },
        {
          "stdin": [
            "16",
            "yes"
          ],
          "expected": "Too young to vote"
        },
        {
          "stdin": [
            "18",
            "no"
          ],
          "expected": "Must register first"
        },
        {
          "stdin": [
