        "Negative and even",
        "Negative and odd</pre>",
        "<pre>&gt; python program.py",
        "-7",
        "Negative and odd</pre>",
        "<p>This one needs a nested <code>if</code> inside <strong>both</strong> the",
        "<code>if</code> branch and the <code>else</code> branch &mdash; four",
        "possible outcomes from two levels of two-way choices.</p>"
      ],
      "starter": [
        "n = int(input())",
        "",
        "# TODO: print one of the four results above, based on n's sign and parity"
      ],
      "tests": [
        {
          "stdin": [
            "4"
          ],
          "expected": "Non-negative and even"
        },
        {
          "stdin": [
            "7"
          ],
          "expected": "Non-negative and odd"
        },
        {
          "stdin": [
            "-4"
          ],
          "expected": "Negative and even"
        },
        {
          "stdin": [
            "-7"
          ],
          "expected": "Negative and odd"
        },
        {
          "stdin": [
            "0"
          ],
          "expected": "Non-negative and even"
        }
      ]
    },
