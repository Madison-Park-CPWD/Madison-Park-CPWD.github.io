            "no"
          ],
          "expected": "Cannot vote"
        },
        {
          "stdin": [
            "16",
            "yes"
          ],
          "expected": "Cannot vote"
        },
        {
          "stdin": [
            "18",
            "no"
          ],
          "expected": "Cannot vote"
        },
        {
          "stdin": [
            "17",
            "no"
          ],
          "expected": "Cannot vote"
        }
