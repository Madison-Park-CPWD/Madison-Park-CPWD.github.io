  "exercises": [
    {
      "id": "01",
      "source_unit": "int-math",
      "title": "Sum of Two Integers",
      "sidebar_tag": "+",
      "description": [
        "<p>Read two integers from input, one per line, and print their <strong>sum</strong>",
        "using the <code>+</code> operator.</p>",
        "<pre>&gt; python program.py",
        "3",
        "4",
        "7</pre>",
        "<p>Use <code>int(input())</code> to read each number, and <code>print()</code> to",
        "output the result.</p>"
      ],
      "starter": [
        "# Read two integers, one per line",
        "a = int(input())",
        "b = int(input())",
        "",
        "# TODO: print the sum of a and b"
      ],
      "tests": [
        {
          "stdin": [
            "3",
            "4"
          ],
          "expected": "7"
        },
        {
          "stdin": [
            "10",
            "15"
          ],
          "expected": "25"
        },
        {
          "stdin": [
            "-5",
            "8"
          ],
          "expected": "3"
        },
        {
          "stdin": [
            "100",
            "250"
          ],
          "expected": "350"
        },
        {
          "stdin": [
            "0",
            "0"
          ],
          "expected": "0"
        }
      ]
    },
