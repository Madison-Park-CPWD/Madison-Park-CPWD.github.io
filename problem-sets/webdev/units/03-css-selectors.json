        { "description": "The first em is untouched", "selector": "#note-em", "check": "style", "property": "background-color", "expected": "rgba(0, 0, 0, 0)" },
        { "description": "The second em is untouched", "selector": "#warn-em", "check": "style", "property": "background-color", "expected": "rgba(0, 0, 0, 0)" }
