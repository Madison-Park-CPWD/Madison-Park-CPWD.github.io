    {
      "id": "16",
      "source_unit": "css-selectors",
      "title": "Right After the Heading",
      "difficulty": 1,
      "sidebar_tag": "Sibling Selector",
      "description": [
        "<p>There are two <code>&lt;h2&gt;</code> headings. The first is followed by one paragraph; the second is followed by two paragraphs. A third paragraph stands alone with no heading before it.</p>",
        "<p>Write an <strong>adjacent sibling selector</strong> (<code>h2 + p</code>) that colors only the paragraph that comes <em>immediately</em> after an <code>&lt;h2&gt;</code>.</p>"
      ],
      "starter": {
        "html": [
          "<h2 id=\"heading-1\">Section One</h2>",
