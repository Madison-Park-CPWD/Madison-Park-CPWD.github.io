        "js": []
      },
      "tests": [
        { "description": "The paragraph span is colored", "selector": "#span-para", "check": "style", "property": "background-color", "expected": "rgb(255, 230, 0)" },
        { "description": "The nav span is colored", "selector": "#span-nav", "check": "style", "property": "background-color", "expected": "rgb(255, 230, 0)" },
        { "description": "The footer span is colored", "selector": "#span-footer", "check": "style", "property": "background-color", "expected": "rgb(255, 230, 0)" },
        { "description": "The plain div is untouched", "selector": "#plain-div", "check": "style", "property": "background-color", "expected": "rgba(0, 0, 0, 0)" }
      ]
    },
