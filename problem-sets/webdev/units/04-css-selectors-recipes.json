    {
      "id": "01",
      "source_unit": "css-selectors-recipes",
      "title": "Color Every Paragraph",
      "difficulty": 1,
      "sidebar_tag": "Tag Selector",
      "description": [
        "<p>A recipe box page has a header, a nav, two paragraphs, and a footer.</p>",
        "<p>In the <strong>CSS</strong> panel, write a <strong>tag selector</strong> that gives every <code>&lt;p&gt;</code> element a <code>background-color</code> of <code>#ffe600</code>. Nothing else on the page should change.</p>"
      ],
      "starter": {
        "html": [
          "<header id=\"site-header\">Grandma's Recipe Box</header>",
          "<nav id=\"site-nav\">Breakfast | Lunch | Dinner</nav>",
          "<p id=\"para-1\">Welcome to my favorite recipes.</p>",
          "<p id=\"para-2\">Updated every week with something new.</p>",
          "<footer id=\"site-footer\">Recipe Box Footer</footer>"
        ],
        "css": [
          "/* Write your tag selector rule here */"
        ],
        "js": []
      },
      "tests": [
        { "description": "The first paragraph is colored", "selector": "#para-1", "check": "style", "property": "background-color", "expected": "rgb(255, 230, 0)" },
        { "description": "The second paragraph is colored", "selector": "#para-2", "check": "style", "property": "background-color", "expected": "rgb(255, 230, 0)" },
        { "description": "The header is untouched", "selector": "#site-header", "check": "style", "property": "background-color", "expected": "rgba(0, 0, 0, 0)" },
        { "description": "The nav is untouched", "selector": "#site-nav", "check": "style", "property": "background-color", "expected": "rgba(0, 0, 0, 0)" },
        { "description": "The footer is untouched", "selector": "#site-footer", "check": "style", "property": "background-color", "expected": "rgba(0, 0, 0, 0)" }
      ]
    },
